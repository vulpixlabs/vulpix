# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# 1. Secrets — keep .env.example as contract
.env*
!.env.example
*.keystore
*.jks
signing-key-info.txt

# 2. Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 3. Build & framework
.next/
out/
build/
dist/
.turbo/
coverage/
.vercel/
*.tsbuildinfo
next-env.d.ts

# 4. Logs & QA artifacts
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.playwright-mcp/
playwright-report/
test-results/
blob-report/

# 5. Images — strict, but keep PWA required assets
*.png
*.jpg
*.jpeg
*.webp
*.avif
!public/vulpix-logo.png
!public/icons/**
!public/screenshots/**
!public/apple-touch-icon.png
!public/brands/anthropic.svg
!public/brands/cohere.svg
!public/brands/databricks.svg
!public/brands/deepseek.svg
!public/brands/elevenlabs.svg
!public/brands/google.svg
!public/brands/googlegemini.svg
!public/brands/meta.svg
!public/brands/microsoft.svg
!public/brands/minimax.svg
!public/brands/mistralai.svg
!public/brands/moonshotai.svg
!public/brands/nvidia.svg
!public/brands/openai.svg
!public/brands/qwen.svg
!public/brands/replicate.svg
!public/brands/stabilityai.svg
!public/brands/xai.svg

# 6. Misc OS
.DS_Store
*.pem
*.apk
*.aab
android/

# 7. Docs — strict: only README + deployment runbook + legal (keep agent contracts)
*.md
!README.md
!AGENTS.md
!CLAUDE.md
!LICENSE.md
!CONTRIBUTING.md
!docs/deployment.md
