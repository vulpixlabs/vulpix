# Upstash Redis REST (direct, not via Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hugging Face (read token, optional but recommended for rate limits)
HF_TOKEN=

# OpenRouter (used by cron sync for richer model specs)
OPENROUTER_API_KEY=

# Cron guard: requests must send "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Public site URL (used for metadataBase / OG)
NEXT_PUBLIC_SITE_URL=
